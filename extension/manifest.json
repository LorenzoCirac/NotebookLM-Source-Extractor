{
  "manifest_version": 3,
  "name": "NotebookLM Source Extractor",
  "version": "1.0.0",
  "description": "Save every source of a NotebookLM notebook as Markdown: one .md file per source, or all of them in one file.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "downloads"],
  "host_permissions": ["https://notebooklm.google.com/*", "https://notebook.google.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Extract NotebookLM sources",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
